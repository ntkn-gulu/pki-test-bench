# Keep Unix line endings for files that Git Bash / Python / OpenSSL read,
# so a Windows clone (core.autocrlf=true) does not break the .sh scripts with "$'\r'".
*.sh    text eol=lf
*.py    text eol=lf
*.cnf   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

# PowerShell scripts stay CRLF (Windows PowerShell 5.1)
*.ps1   text eol=crlf

# Binary assets
*.woff2 binary
